# NerveSight — Environment Variables
# Copy this to .env and fill in your values
# Never commit .env to git

# ─── Anthropic (for AI insights)
ANTHROPIC_API_KEY=sk-ant-...

# ─── Tally connection (for live mode)
TALLY_HOST=localhost
TALLY_PORT=9000

# ─── App config
NERVESIGHT_MODE=static          # static | live
NERVESIGHT_XML_PATH=data/sample_tally_export.xml
